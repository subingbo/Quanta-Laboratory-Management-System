# 复制为 .env 并按实际填写；.env 已在 gitignore 里排除，不要提交
# ---- MySQL ----
MYSQL_ROOT_PASSWORD=ChangeMe_Root_Strong_2026
MYSQL_USERNAME=quanta
MYSQL_PASSWORD=ChangeMe_Quanta_Strong_2026

# ---- Redis ----
REDIS_PASSWORD=ChangeMe_Redis_Strong_2026

# ---- 应用运行参数 (run.sh / ruoyi.service 读取) ----
# 部署目标主机 SSH（upload.py 用）
ECS_HOST=1.2.3.4
ECS_PORT=22
ECS_USER=root
ECS_PASSWORD=your_ssh_password
# 服务器上应用安装目录
APP_HOME=/opt/ruoyi

# ---- JWT 签名密钥（必填，勿用任何公开默认值）----
# 生成：openssl rand -base64 48   （Windows 可用 PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 } | ForEach-Object {[byte]$_}))）
# 换掉此值会让所有已签发 token 失效，用户需重新登录
TOKEN_SECRET=ChangeMe_Generate_A_Random_48plus_Chars
# 可选：Druid 监控台（默认关闭；仅排查时临时开，且只允许本机）
# DRUID_STAT_ENABLED=false
# DRUID_STAT_ALLOW=127.0.0.1
# DRUID_STAT_USER=ruoyi
# DRUID_STAT_PASSWORD=ChangeMe_Druid_Strong_2026
